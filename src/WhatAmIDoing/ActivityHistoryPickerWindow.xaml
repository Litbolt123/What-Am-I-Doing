<Window x:Class="WhatAmIDoing.ActivityHistoryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="520"
        MinWidth="480" MinHeight="400"
        Background="{StaticResource DashBgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource DashCardBorder}" Margin="0,0,0,10" Padding="12">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Style="{StaticResource DashBodyText}"/>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource DashCardBorder}" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Time range" Style="{StaticResource DashHintText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="RangeCombo" SelectionChanged="RangeCombo_OnSelectionChanged">
                    <ComboBoxItem Content="Last 2 hours" Tag="2h" IsSelected="True"/>
                    <ComboBoxItem Content="Last 6 hours" Tag="6h"/>
                    <ComboBoxItem Content="Today (since midnight)" Tag="today"/>
                    <ComboBoxItem Content="Yesterday" Tag="yesterday"/>
                    <ComboBoxItem Content="Last 7 days" Tag="7d"/>
                    <ComboBoxItem Content="Last 30 days" Tag="30d"/>
                    <ComboBoxItem Content="Custom (back from now)" Tag="custom"/>
                </ComboBox>
                <StackPanel x:Name="CustomRangePanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CustomDurationBox" Width="80" Height="28" VerticalContentAlignment="Center"
                                 Text="30" LostFocus="CustomRangeFields_OnChanged"/>
                        <ComboBox x:Name="CustomUnitCombo" Width="110" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                  SelectionChanged="CustomUnitCombo_OnSelectionChanged">
                            <ComboBoxItem Content="minutes" IsSelected="True"/>
                            <ComboBoxItem Content="hours"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource DashCardBorder}" Padding="8">
            <ListBox x:Name="ItemsList" BorderThickness="0"
                     DisplayMemberPath="DisplayLabel"
                     MouseDoubleClick="ItemsList_OnMouseDoubleClick"/>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource DashCardBorder}" Padding="10,8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DashToolbarButton}" IsCancel="True" Click="Cancel_OnClick"/>
                <Button Content="Use selected" Style="{StaticResource DashPrimaryButton}" IsDefault="True" Click="Ok_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
